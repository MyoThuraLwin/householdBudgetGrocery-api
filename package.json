{
  "name": "household-budget-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-vendor-license.mjs",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed-auth.ts",
    "auth:setup": "tsx scripts/setup-auth.ts",
    "db:demo": "tsx prisma/demo-users.ts",
    "contract": "tsx scripts/export-contract.ts",
    "test:sql": "tsx scripts/test-sql.ts",
    "check": "npm test && npm run build && npm run contract:check",
    "contract:check": "tsx scripts/check-contract.ts"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "async-mutex": "0.5.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.15",
    "msnodesqlv8": "^5.0.0",
    "mssql": "^12.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/mssql": "^9.1.8",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "description": "Homewise household budget and grocery REST API for Windows and SQL Server.",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
