PORT=4000
APP_ORIGIN=http://localhost:5173
SQL_SERVER=localhost
SQL_DATABASE=HouseholdBudgetGrocery
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUST_CERTIFICATE=true
DATABASE_URL="sqlserver://localhost;database=HouseholdBudgetGrocery;integratedSecurity=true;trustServerCertificate=true"
# Run npm run auth:setup to generate a private signing key. Never use a demo key.
JWT_SECRET=
# Set true when serving the app over HTTPS. Production always uses Secure cookies.
COOKIE_SECURE=false
# Optional OpenAI-compatible chat-completions service. Core features do not require AI.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
